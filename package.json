{
  "name": "nano-defenders",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:images": "node scripts/gen-images.mjs",
    "gen:voice": "node scripts/gen-voice.mjs",
    "deploy": "npm run build && NODE_OPTIONS=\"--import tsx\" cf deploy dist"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "cf": "^1.0.0-beta.30",
    "lamejs": "^1.2.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
