# Cloudflare static assets headers (see cloudflare.config.ts).
# The page, service worker and file list must always be revalidated so updates reach installed iPads.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/precache.json
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Vite bundles have a content hash in their name.
/assets/index-*
  Cache-Control: public, max-age=31536000, immutable
